{
  "$schema": "https://raw.githubusercontent.com/reF1nd/sing-box/reF1nd-testing/docs/schema.json",
  "providers": [
    {
      "tag": "JC1",
      "type": "remote",
      "url": "此处填入订阅链接",
      "health_check": {
        "enabled": true,
        "url": "https://www.gstatic.com/generate_204",
        "interval": "12h",
        "timeout": "3s"
      },
      "exclude": "官网|剩余|流量|套餐|免费|订阅|全球直连|到期时间|GB|Expire Date|Traffic|ExpireDate",
      "http_client": "直连下载",
      "update_interval": "240h"
    }
  ],
  "dns": {
    "servers": [
      { "tag": "local", "type": "local", "prefer_go": true },
      { "tag": "ali", "type": "https", "server": "223.5.5.5" },
      { "tag": "tx", "type": "https", "server": "doh.pub", "domain_resolver": "hosts" },
      { "tag": "google", "type": "https", "server": "8.8.8.8", "detour": "默认代理" },
      { "tag": "fakeip", "type": "fakeip", "inet4_range": "198.19.0.0/16" },
      { "type": "hosts", "tag": "hosts", "predefined": { "doh.pub": [ "1.12.12.21", "120.53.53.53" ] } }
    ],
    "rules": [
      { "query_type": [ "HTTPS", "SVCB" ], "action": "reject" },
      { "clash_mode": "Direct", "server": "ali" },
      { "clash_mode": "Global", "server": "fakeip" },
      { "rule_set": [ "fakeipfilter-cn", "geosite-cn", "geosite-private" ], "server": "ali" },
      { "rule_set": "fakeipfilter-!cn", "server": "google" },
      { "type": "logical", "mode": "and", "rules": [ { "query_type": [ "A", "AAAA" ] }, { "rule_set": "geosite-geolocation-!cn", "invert": true } ], "action": "evaluate", "server": "google", "client_subnet": "223.5.5.0/24", "timeout": "2s" },
      { "match_response": true, "rule_set": "geoip-cn", "server": "ali" },
      { "query_type": [ "A", "AAAA" ], "server": "fakeip", "rewrite_ttl": 1 }
    ],
    "final": "google",
    "strategy": "ipv4_only",
    "cache_capacity": 8192,
    "optimistic": { "enabled": true },
    "reverse_mapping": true
  },
  "outbounds": [
    { "tag": "默认代理", "type": "selector", "outbounds": [ "日本手动", "狮城手动", "香港手动", "美国手动", "手动选择" ] },
    { "tag": "漏网之鱼", "type": "selector", "outbounds": [ "默认代理", "日本手动", "狮城手动", "香港手动", "美国手动", "手动选择", "直连" ] },
    { "tag": "日本手动", "type": "selector", "outbounds": null, "use_all_providers": true, "include": "🇯🇵|JP|jp|日本|日|Japan", "exclude": "HK" },
    { "tag": "狮城手动", "type": "selector", "outbounds": null, "use_all_providers": true, "include": "新加坡|坡|狮城|SG|Singapore", "exclude": "日" },
    { "tag": "香港手动", "type": "selector", "outbounds": null, "use_all_providers": true, "include": "港|HK|(?i)Hong", "exclude": "日" },
    { "tag": "美国手动", "type": "selector", "outbounds": null, "use_all_providers": true, "include": "🇺🇸|US|us|美国|美|United States", "exclude": "日|AUS|RUS" },
    { "tag": "手动选择", "type": "selector", "outbounds": null, "use_all_providers": true, "exclude": "网站|流量|地址|剩余|过期|免费|时间|有效|Traffic|ExpireDate|GB|Expire Date" },
    { "tag": "延迟辅助", "type": "urltest", "outbounds": [ "直连" ], "url": "http://connect.rom.miui.com/generate_204", "interval": "30m" },
    { "tag": "GLOBAL", "type": "selector", "outbounds": [ "默认代理", "漏网之鱼", "日本手动", "狮城手动", "香港手动", "美国手动", "手动选择", "延迟辅助", "直连" ] },
    { "tag": "直连", "type": "direct", "domain_resolver": "ali" }
  ],
  "http_clients": [
    { "tag": "直连下载", "detour": "直连" }
  ],
  "route": {
    "rules": [
      { "type": "logical", "mode": "and", "rules": [ { "port": [ 53, 853 ], "invert": true }, { "clash_mode": "Global", "invert": true }, { "type": "logical", "mode": "or", "rules": [ { "ip_is_private": true }, { "rule_set": "geoip-cn" } ] } ], "action": "bypass" },
      { "type": "logical", "mode": "or", "rules": [ { "domain_suffix": "push.apple.com" } ], "invert": true, "action": "sniff", "sniffer": [ "http", "tls", "stun", "quic", "dns" ], "timeout": "100ms" },
      { "type": "logical", "mode": "or", "rules": [ { "port": 53 }, { "protocol": "dns" } ], "action": "hijack-dns" },
      { "ip_is_private": true, "outbound": "直连" },
      { "type": "logical", "mode": "or", "rules": [ { "port": 853 }, { "protocol": [ "stun", "quic" ] } ], "action": "reject", "no_drop": true },
      { "network": "icmp", "action": "resolve" },
      { "network": "icmp", "outbound": "直连" },
      { "clash_mode": "Direct", "outbound": "直连" },
      { "clash_mode": "Global", "outbound": "GLOBAL" },
      { "rule_set": "geosite-private", "outbound": "直连" },
      { "rule_set": "geosite-geolocation-!cn", "outbound": "默认代理" },
      { "inbound": "mixed-in", "action": "resolve", "match_only": true },
      { "rule_set": "geoip-cn", "outbound": "直连" }
    ],
    "rule_set": [
      { "tag": [ "fakeipfilter-cn", "fakeipfilter-!cn" ], "type": "remote", "format": "source", "url": "https://gh-proxy.com/https://raw.githubusercontent.com/qichiyuhub/rule/refs/heads/main/rules/{tag}.json" },
      { "tag": [ "geosite-geolocation-!cn", "geosite-cn", "geosite-private" ], "type": "remote", "format": "binary", "url": "https://gh-proxy.com/https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/{tag}.srs" },
      { "tag": "geoip-cn", "type": "remote", "format": "binary", "url": "https://gh-proxy.com/https://raw.githubusercontent.com/SagerNet/sing-geoip/rule-set/geoip-cn.srs" }
    ],
    "final": "漏网之鱼",
    "default_http_client": "直连下载",
    "auto_detect_interface": true,
    "default_domain_resolver": { "server": "ali" }
  },
  "inbounds": [
    {
      "tag": "tun-in",
      "type": "tun",
      "address": [
        "172.19.0.1/30",
        "fdfe:dcba:9876::1/126"
      ],
      "auto_route": true,
      "auto_redirect": true
    },
    {
      "tag": "mixed-in",
      "type": "mixed",
      "listen": "0.0.0.0",
      "listen_port": 7890
    }
  ],
  "services": [
    {
      "type": "api",
      "listen": "0.0.0.0",
      "listen_port": 9090,
      "secret": "passwd",
      "dashboard": {
        "enabled": true,
        "path": "/etc/sing-box/dashboard",
        "download_url": "https://gh-proxy.com/https://github.com/SagerNet/sing-box-dashboard/archive/refs/heads/gh-pages.zip"
      }
    }
  ],
  "experimental": {
    "cache_file": {
      "enabled": true,
      "path": "/etc/sing-box/cache.db",
      "store_dns": true
    },
    "clash_api": {
      "external_controller": "0.0.0.0:9095",
      "external_ui": "/etc/sing-box/ui",
      "external_ui_download_url": "https://gh-proxy.com/https://github.com/Zephyruso/zashboard/archive/refs/heads/gh-pages.zip",
      "secret": "passwd",
      "default_mode": "Rule",
      "access_control_allow_origin": [
        "*"
      ]
    }
  },
  "certificate": {
    "store": "chrome"
  },
  "ntp": {
    "enabled": true,
    "server": "time.apple.com"
  },
  "log": {
    "disabled": false,
    "level": "info",
    "timestamp": true
  }
}